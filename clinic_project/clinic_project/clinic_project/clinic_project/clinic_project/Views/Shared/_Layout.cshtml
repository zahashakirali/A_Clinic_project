<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ClinicDB Admin</title>
    <link rel="icon" type="image/png" href="/favicons-admin/favicon-96x96.png" sizes="96x96" />
    <link rel="stylesheet" href="~/assets/css/styles.min.css" />
    <style>
        /* ✅ Top bar */
        .top-bar {
            background: #fff;
            border-bottom: 1px solid #eee;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 65px;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
        }

        /* ✅ Sidebar starts BELOW top bar */
        .left-sidebar {
            width: 70px;
            overflow: hidden;
            transition: width 0.3s ease;
            position: fixed;
            top: 65px;
            left: 0;
            height: calc(100vh - 65px);
            z-index: 999;
            background: #fff;
            box-shadow: 2px 0 8px rgba(0,0,0,0.08);
            overflow-y: auto;
        }

            .left-sidebar.open {
                width: 270px;
            }

            /* ✅ Center icons when collapsed */
            .left-sidebar:not(.open) .sidebar-link {
                display: flex !important;
                justify-content: center !important;
                padding: 14px 0 !important;
            }

                .left-sidebar:not(.open) .sidebar-link i {
                    font-size: 22px;
                    margin: 0 !important;
                }

            /* ✅ Hide text when collapsed */
            .left-sidebar:not(.open) .hide-menu,
            .left-sidebar:not(.open) .nav-small-cap,
            .left-sidebar:not(.open) .sidebar-divider,
            .left-sidebar:not(.open) .has-arrow::after,
            .left-sidebar:not(.open) .brand-logo {
                display: none !important;
            }

            /* ✅ Show brand logo only when open */
            .left-sidebar.open .brand-logo {
                display: flex !important;
                align-items: center;
                gap: 10px;
                padding: 16px 16px;
                border-bottom: 1px solid #f0f0f0;
            }

        .clinic-brand-text {
            font-weight: 700;
            font-size: 18px;
            color: #5d87ff;
            white-space: nowrap;
        }

        /* ✅ Body content pushed right */
        .body-wrapper {
            margin-left: 70px;
            margin-top: 65px;
            transition: margin-left 0.3s ease;
            min-height: calc(100vh - 65px);
        }

            .body-wrapper.shifted {
                margin-left: 270px;
            }

        /* ✅ Dim overlay when sidebar open */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 65px;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.3);
            z-index: 998;
        }

            .sidebar-overlay.show {
                display: block;
            }

        #sidebarToggle {
            background: transparent;
            border: none;
            font-size: 26px;
            cursor: pointer;
            color: #5d87ff;
            line-height: 1;
        }
    </style>
</head>
<body>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="top-bar">
        <div class="d-flex align-items-center gap-3">
            <button id="sidebarToggle">&#9776;</button>
            <img src="/favicons-admin/favicon-96x96.png" alt="logo" width="38" height="38" style="border-radius:50%;" />
            <span style="font-weight:800; font-size:22px; color:#5d87ff;">ClinicDB</span>
        </div>
        <span style="color:#aaa; font-size:13px;">Admin Panel</span>
    </div>

    <div class="page-wrapper" id="main-wrapper">

        <aside class="left-sidebar" id="mainSidebar">

            <div class="brand-logo">
