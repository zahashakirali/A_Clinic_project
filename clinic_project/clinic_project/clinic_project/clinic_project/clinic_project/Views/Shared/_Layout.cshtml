                            </li>
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Home" asp-action="AddLecture">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="ti ti-plus"></i>
                                        <span class="hide-menu">Add Lecture</span>
                                    </div>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-small-cap">
                        <iconify-icon icon="solar:menu-dots-linear" class="nav-small-cap-icon fs-4"></iconify-icon>
                        <span class="hide-menu">Seminar</span>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link justify-content-between has-arrow" href="#" data-bs-toggle="collapse" data-bs-target="#semCollapse" aria-expanded="false">
                            <div class="d-flex align-items-center gap-3">
                                <i class="ti ti-building-hospital"></i>
                                <span class="hide-menu">Seminar</span>
                            </div>
                        </a>
                        <ul id="semCollapse" class="collapse first-level" data-bs-parent="#sidebarnav">
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Home" asp-action="Seminar">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="ti ti-list"></i>
                                        <span class="hide-menu">Seminar List</span>
                                    </div>
                                </a>
                            </li>
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Home" asp-action="AddSeminar">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="ti ti-plus"></i>
                                        <span class="hide-menu">Add Seminar</span>
                                    </div>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-small-cap">
                        <iconify-icon icon="solar:menu-dots-linear" class="nav-small-cap-icon fs-4"></iconify-icon>
                        <span class="hide-menu">Staff</span>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link justify-content-between has-arrow" href="#" data-bs-toggle="collapse" data-bs-target="#staffCollapse" aria-expanded="false">
                            <div class="d-flex align-items-center gap-3">
                                <i class="ti ti-building-hospital"></i>
                                <span class="hide-menu">Staff</span>
                            </div>
                        </a>
                        <ul id="staffCollapse" class="collapse first-level" data-bs-parent="#sidebarnav">
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Home" asp-action="Staff">
                                    <div class="d-flex align-items-center gap-3">
