                    <li class="nav-small-cap">
                        <iconify-icon icon="solar:menu-dots-linear" class="nav-small-cap-icon fs-4"></iconify-icon>
                        <span class="hide-menu">Equipment</span>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link justify-content-between has-arrow" href="#" data-bs-toggle="collapse" data-bs-target="#eqCollapse" aria-expanded="false">
                            <div class="d-flex align-items-center gap-3">
                                <i class="ti ti-building-hospital"></i>
                                <span class="hide-menu">Equipment</span>
                            </div>
                        </a>
                        <ul id="eqCollapse" class="collapse first-level" data-bs-parent="#sidebarnav">
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Equipment" asp-action="EquipmentList">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="ti ti-list"></i>
                                        <span class="hide-menu">Equipment List</span>
                                    </div>
                                </a>
                            </li>
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Equipment" asp-action="AddEquipment">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="ti ti-plus"></i>
                                        <span class="hide-menu">Add Equipment</span>
                                    </div>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-small-cap">
                        <iconify-icon icon="solar:menu-dots-linear" class="nav-small-cap-icon fs-4"></iconify-icon>
                        <span class="hide-menu">Medicine</span>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link justify-content-between has-arrow" href="#" data-bs-toggle="collapse" data-bs-target="#medCollapse" aria-expanded="false">
                            <div class="d-flex align-items-center gap-3">
                                <i class="ti ti-pill"></i>
                                <span class="hide-menu">Medicine</span>
                            </div>
                        </a>
                        <ul id="medCollapse" class="collapse first-level" data-bs-parent="#sidebarnav">
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Medicine" asp-action="MedicineList">
