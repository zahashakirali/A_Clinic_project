                                        <i class="ti ti-list"></i>
                                        <span class="hide-menu">Medicine List</span>
                                    </div>
                                </a>
                            </li>
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Medicine" asp-action="AddMedicine">
