                    <li class="nav-small-cap">
                        <iconify-icon icon="solar:menu-dots-linear" class="nav-small-cap-icon fs-4"></iconify-icon>
                        <span class="hide-menu">Practical</span>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link justify-content-between has-arrow" href="#" data-bs-toggle="collapse" data-bs-target="#pracCollapse" aria-expanded="false">
                            <div class="d-flex align-items-center gap-3">
                                <i class="ti ti-building-hospital"></i>
                                <span class="hide-menu">Practical</span>
                            </div>
                        </a>
                        <ul id="pracCollapse" class="collapse first-level" data-bs-parent="#sidebarnav">
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Home" asp-action="PracticalList">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="ti ti-list"></i>
                                        <span class="hide-menu">Practical List</span>
                                    </div>
                                </a>
                            </li>
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Home" asp-action="AddPractical">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="ti ti-plus"></i>
                                        <span class="hide-menu">Add Practical</span>
                                    </div>
                                </a>
