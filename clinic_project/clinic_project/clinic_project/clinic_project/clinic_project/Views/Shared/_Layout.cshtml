                                        <span class="hide-menu">Staff List</span>
                                    </div>
                                </a>
                            </li>
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Home" asp-action="AddStaff">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="ti ti-plus"></i>
                                        <span class="hide-menu">Add Staff</span>
                                    </div>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-small-cap">
                        <iconify-icon icon="solar:menu-dots-linear" class="nav-small-cap-icon fs-4"></iconify-icon>
                        <span class="hide-menu">Subject</span>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link justify-content-between has-arrow" href="#" data-bs-toggle="collapse" data-bs-target="#subCollapse" aria-expanded="false">
                            <div class="d-flex align-items-center gap-3">
                                <i class="ti ti-building-hospital"></i>
                                <span class="hide-menu">Subject</span>
                            </div>
                        </a>
                        <ul id="subCollapse" class="collapse first-level" data-bs-parent="#sidebarnav">
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Home" asp-action="SubjectList">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="ti ti-list"></i>
                                        <span class="hide-menu">Subject List</span>
                                    </div>
                                </a>
                            </li>
                            <li class="sidebar-item">
                                <a class="sidebar-link" asp-controller="Home" asp-action="AddSubject">
                                    <div class="d-flex align-items-center gap-3">
