                        <span class="hide-menu">Users</span>
                    </li>
                    <li class="sidebar-item">
                        <a class="sidebar-link justify-content-between has-arrow" href="#" data-bs-toggle="collapse" data-bs-target="#usersCollapse" aria-expanded="false">
