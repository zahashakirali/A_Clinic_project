@{
    ViewData["Title"] = "Medicine";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<style>

    body {
        background-color: #f4f9ff;
    }

    /* PAGE SPACE FIX */
    .medicine-section {
        padding-top: 120px;
        padding-bottom: 60px;
    }

    .page-heading {
        text-align: center;
        margin-bottom: 50px;
    }

        .page-heading h1 {
            color: #0d6efd;
            font-weight: 700;
        }

        .page-heading p {
            color: #6c757d;
        }

    /* CARD DESIGN */
    .medicine-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        background: white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transition: 0.3s;
        height: 100%;
    }

        .medicine-card:hover {
            transform: translateY(-5px);
        }

    .medicine-img {
        width: 100%;
        height: 220px;
        object-fit: cover;
    }

    .medicine-title {
        color: #0d6efd;
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .feature-item {
        background: #eef5ff;
        padding: 10px;
        border-radius: 10px;
        margin-bottom: 10px;
        font-size: 14px;
    }

    .btn-custom {
        background: #0d6efd;
        color: white;
        border-radius: 30px;
        padding: 10px 25px;
        text-decoration: none;
        display: inline-block;
        transition: 0.3s;
    }

        .btn-custom:hover {
            background: #0b5ed7;
            color: white;
        }

</style>

<main>

    <section class="medicine-section">

        <div class="container">

            <!-- HEADING -->
            <div class="page-heading">
                <h1>Medicine</h1>
                <p>
                    Caring for Your Health, One Medicine at a Time
                </p>
            </div>

            <!-- CARDS -->
            <div class="row g-4">

                @foreach (var roledata in Model)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">

                        <div class="card medicine-card">

                            <img src="@roledata.Image"
                                 class="medicine-img"
                                 alt="Medicine">

                            <div class="card-body">

                                <h3 class="medicine-title">
                                    @roledata.Name
                                </h3>

                                <div class="feature-item">
                                    <strong>Type:</strong> @roledata.Type
                                </div>

                                <div class="feature-item">
                                    <strong>Price:</strong> @roledata.Price
                                </div>





                                <div class="text-center mt-4">
                                    <form  asp-action="addtocart" method="post">

                                        <input type="hidden" name="productId" value="@roledata.MedicineId" />
                                        <input type="hidden" name="productType" value="Medicine" /> 
                                        <button type="submit" class="btn-custom" >
                                            ADD TO CART
                                        </button>
                                    </form>
                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

    </section>

</main>