@model IEnumerable<clinic_project.Models.Equipment>
@{
    ViewData["Title"] = "Equipment";
    Layout = "~/Views/Shared/_layout1.cshtml";
}

<br>
<section id="equipment" class="doctors section">
    <br />
    <div class="container section-title" data-aos="fade-up">
        <h2>Equipment</h2>
        <p>
            Explore the medical equipment available at our clinic. We use only
            the highest quality tools to ensure the best care for our patients.
        </p>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        @if (!Model.Any())
        {
            <p class="text-center text-muted">No equipment found.</p>
        }

        <div class="row gy-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="doctor-card h-100 d-flex flex-column">

                        <!-- Image -->
                        <div class="doctor-image" style="border-radius:12px; overflow:hidden; aspect-ratio:unset; width:100%;">
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="@item.Image" alt="@item.Name"
                                     style="width:100%; height:220px; object-fit:cover; border-radius:12px;" />
                            }
                            else
                            {
                                <img src="~/assets/img/health/staff-5.webp" alt="No Image"
                                     style="width:100%; height:220px; object-fit:cover; border-radius:12px;" />
                            }
                        </div>

                        <!-- Content -->
                        <div class="doctor-content flex-grow-1 d-flex flex-column">
                            <h4>@item.Name</h4>
                            <span class="specialty">Medical Equipment</span>
                            <p>@(string.IsNullOrEmpty(item.Description) ? "No description available." : item.Description)</p>

                            <div class="doctor-meta">
                                <div class="experience">
                                    <i class="bi bi-box-seam"></i>
                                    <span>Stock: @item.Stock</span>
                                </div>
                                <div class="department">
                                    <i class="bi bi-tag"></i>
                                    <span>$@item.Price</span>
                                </div>
                            </div>

                            <!-- ✅ Add to Cart button pinned to bottom -->
                            <div class="mt-auto pt-3">
                                <form asp-action="addtocart" method="post">

                                    <input type="hidden" name="productId" value="@item.EquipmentId" />
                                    <input type="hidden" name="productType" value="Equipment" />
                                    <button type="submit" class="btn-custom">
                                        ADD TO CART
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</section>

