
@{
    ViewData["Title"] = "MyOrders";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

@model IEnumerable<clinic_project.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}
<br /> 
<br /> 
<br /> 
<br />
<br />
<br />
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-bag-check-fill text-primary"></i> Your Order History</h2>
        <a href="@Url.Action("Index", "Home2")" class="btn btn-outline-secondary btn-sm">Continue Shopping</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center py-5" role="alert">
            <i class="bi bi-cart-x" style="font-size: 3rem;"></i>
            <h4 class="mt-3">No Orders Found!</h4>
            <p class="text-muted">Aap ne abhi tak koi order place nahi kiya hai.</p>
            <a href="@Url.Action("Medicine", "Home2")" class="btn btn-primary mt-2">Browse Medicines</a>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle bg-white mb-0">
                <thead class="table-dark text-nowrap">
                    <tr>
                        <th scope="col">Order ID</th>
                       
                        <th scope="col">Shipping Address</th>
                        <th scope="col">Payment Method</th>
                        <th scope="col">Total Amount</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-primary">#@order.OrderId</strong>
                            </td>
                           
                            <td class="text-truncate" style="max-width: 200px;" title="@order.ShippingAddress">
                                @order.ShippingAddress
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@order.PaymentMethod</span>
                            </td>
                            <td>
                                <strong class="text-success">@string.Format("{0:C}", order.TotalAmount)</strong>
                            </td>
                            <td>
                                @if (order.Status?.ToLower() == "pending")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Pending</span>
                                }
                                else if (order.Status?.ToLower() == "completed" || order.Status?.ToLower() == "delivered")
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill">Delivered</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill">@order.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

