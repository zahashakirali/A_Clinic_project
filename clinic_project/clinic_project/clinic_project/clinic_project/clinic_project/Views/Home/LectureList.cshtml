@model IEnumerable<clinic_project.Models.Lecture>

@{
    ViewData["Title"] = "Lecture List";
}

<h2 class="text-center text-primary mb-4">Lecture List</h2>

<div class="container d-flex justify-content-center">
    <table class="table table-striped table-bordered table-hover w-75 text-center">
        <thead class="table-primary">
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Subject</th>
                <th>Staff</th>
                <th>Date</th>
                <th>Time</th>
                <th>Room No</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lecture in Model)
            {
                <tr>
                    <td>@lecture.LectureTitle</td>
                    <td>@lecture.LectureDescription</td>
                    <td>@lecture.Subject?.SubjectName</td>
                    <td>@lecture.Staff?.StaffId</td>
                    <td>@lecture.LectureDate?.ToString("dd-MM-yyyy")</td>
                    <td>@lecture.LectureTime?.ToString("hh\\:mm")</td>
                    <td>@lecture.RoomNo</td>
                </tr>
            }
        </tbody>
    </table>
</div>