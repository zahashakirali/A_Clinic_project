<--add equipment-->
@model clinic_project.Models.Equipment
@{
    ViewData["Title"] = "AddEquipment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


    <style>
        /* Form Card */
        .equipment-card {
            background: #ffffff;
            border: none !important;
            border-radius: 10px !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05) !important;
            padding: 30px !important;
        }

        /* Heading */
        .page-title {
            color: #0056b3;
            font-weight: 700;
            margin-bottom: 25px;
        }

        /* Labels */
        .control-label {
            color: #334155;
            font-weight: 600 !important;
            margin-bottom: 8px;
        }

        /* Inputs */
        .form-control {
            border: 1px solid #dbe3ec !important;
            border-radius: 8px !important;
            padding: 10px 14px !important;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #0056b3 !important;
                box-shadow: 0 0 0 0.2rem rgba(0, 86, 179, 0.15) !important;
            }

        textarea.form-control {
            resize: none;
        }

        /* Submit Button */
        .btn-primary {
            background-color: #0056b3 !important;
            border: none !important;
            border-radius: 6px !important;
            padding: 10px 18px !important;
            font-weight: 600 !important;
            transition: all 0.3s ease !important;
        }

            .btn-primary:hover {
                background-color: #004085 !important;
                box-shadow: 0 4px 12px rgba(0, 86, 179, 0.25) !important;
            }

        /* Back Link */
        .btn-link {
            color: #0056b3 !important;
            text-decoration: none !important;
            font-weight: 600;
        }

            .btn-link:hover {
                color: #004085 !important;
                text-decoration: underline !important;
            }

        /* Validation */
        .text-danger {
            font-size: 13px;
        }
    </style>

    <h2 class="text-center page-title">Add Equipment</h2>

    <div class="row">
        <div class="col-md-5 mx-auto equipment-card">

            <!--  enctype is REQUIRED for file upload -->
            <form asp-action="AddEquipment" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter equipment name..." />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description..."></textarea>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Price" class="control-label"></label>
                    <input asp-for="Price" class="form-control" placeholder="Enter price..." />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Stock" class="control-label"></label>
                    <input asp-for="Stock" class="form-control" placeholder="Enter stock quantity..." />
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Image</label>
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                </div>

                <div class="form-group text-center">
                    <input type="submit" value="Add Equipment" class="btn btn-primary w-100" />
                </div>
            </form>

            <div class="mt-3 text-center">
                <a asp-action="EquipmentList" class="btn btn-link">Back to List</a>
            </div>

        </div>
    </div>
