@{
    ViewData["Title"] = "showuser";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="col-md-11 mx-auto">
        
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="text-primary fw-bold mb-0">User Management</h2>
                <p class="text-muted small">Manage and view all registered system users</p>
            </div>
            
        </div>

        <a asp-action="adduser" class="btn btn-success">
            <i class="ti ti-plus"></i> Add User
        </a>
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                      
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-primary text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px; width: 10%;">ID</th>
                                <th class="py-3 text-primary text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Name</th>
                                <th class="py-3 text-primary text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Email</th>
                                <th class="py-3 text-primary text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Phone</th>
                                <th class="py-3 text-primary text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Role</th>
                                <th class="py-3 text-primary text-uppercase fw-bold text-center" style="font-size: 12px; letter-spacing: 0.5px; width: 15%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr style="transition: all 0.2s ease;">
                                    <td class="ps-4 fw-bold text-secondary">#@item.UserId</td>
                                    <td class="fw-semibold text-dark">@item.Name</td>
                                    <td>@item.Email</td>
                                    <td>@item.Phone</td>
                                    <td>
                                        <span class="badge bg-opacity-10 bg-primary text-primary px-3 py-2">
                                            @item.Role.RoleName
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group gap-2">
                                            <a asp-action="EditUser" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-primary rounded-2 px-3">
                                                <i class="zmdi zmdi-edit"></i> Edit
                                            </a>
                                            <a asp-action="DeleteUser" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-danger rounded-2 px-3">
                                                <i class="zmdi zmdi-delete"> delete </i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Adding the soft hover effect from your first snippet */
    .table-hover tbody tr:hover {
        background-color: #f1f5f9 !important;
    }
    /* Simple CSS for the Role Badge if Bootstrap 5 opacity isn't available */
    .badge.bg-primary {
        background-color: #0056b3 !important;
        color: white !important;
    }
</style>