@model clinic_project.Models.Role
@{
    ViewData["Title"] = "editrole";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-container {
        background: #ffffff !important;
        border: none !important;
        border-radius: 10px !important;
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.05) !important;
        padding: 30px !important;
    }

    .form-title {
        color: #0056b3 !important; /* Theme Blue */
        font-weight: 700 !important;
        font-size: 24px;
    }

    .custom-label {
        color: #334155 !important;
        font-size: 14px;
        margin-bottom: 6px;
    }

    .custom-input {
        border: 1px solid #e2e8f0 !important;
        border-radius: 6px !important;
        padding: 10px 14px !important;
        font-size: 14px !important;
        transition: all 0.3s ease !important;
    }

        .custom-input:focus {
            border-color: #0056b3 !important;
            box-shadow: 0 0 0 3px rgba(0, 86, 179, 0.15) !important;
            outline: none;
        }

    /* Edit/Update Button */
    .btn-blue-submit {
        background-color: #0056b3 !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 6px !important;
        padding: 10px 20px !important;
        font-weight: 600 !important;
        font-size: 15px !important;
        transition: all 0.3s ease !important;
    }

        .btn-blue-submit:hover {
            background-color: #004085 !important;
            box-shadow: 0 4px 12px rgba(0, 86, 179, 0.25) !important;
        }

    /* Back Link Button */
    .btn-link-back {
        color: #64748b !important;
        font-weight: 500 !important;
        font-size: 14px !important;
        text-decoration: none !important;
        transition: color 0.2s !important;
    }

        .btn-link-back:hover {
            color: #0056b3 !important;
        }
</style>

<div class="container py-5">
    <h2 class="text-center form-title mb-4">Edit Role</h2>

    <div class="row">
        <div class="col-md-5 mx-auto form-container">

            <form asp-action="editrole" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-4">
                    <label asp-for="RoleName" class="control-label custom-label font-weight-bold">Role Name</label>
                    <input asp-for="RoleName" class="form-control custom-input" placeholder="Modify role name..." />
                    <span asp-validation-for="RoleName" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="form-group text-center mb-0">
                    <button type="submit" class="btn btn-blue-submit w-100">
                        <i class="zmdi zmdi-save mr-1"></i> Save Changes
                    </button>
                </div>
            </form>

            <div class="mt-3 text-center">
                <a asp-action="Rolelist" class="btn btn-link-back">
                    <i class="zmdi zmdi-arrow-left mr-1"></i> Back to List
                </a>
            </div>

        </div>
    </div>
</div>